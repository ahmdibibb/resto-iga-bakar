# Database (PostgreSQL — Render provides this automatically)
DATABASE_URL="postgresql://user:password@host:5432/resto_iga_bakar?schema=public"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# Development: bypass pre-order pickup time rules (11:00-22:00, min 30 menit, cutoff 21:30)
# Otomatis aktif saat NODE_ENV=development. Set ke false untuk uji aturan production di local.
BYPASS_PREORDER_PICKUP_TIME=true
NEXT_PUBLIC_BYPASS_PREORDER_PICKUP_TIME=true

# WhatsApp Business API
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_whatsapp_access_token

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_UPLOAD_PRESET="your_upload_preset"

# Payment timeout (minutes)
PAYMENT_TIMEOUT_MINUTES=10

# Midtrans Snap Payment Gateway
# Get your keys from https://dashboard.sandbox.midtrans.com/settings/config_info
# For production, use keys from https://dashboard.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
